  <div class="stats"><div class="sr"><span class="l">Size 3x3</span><span class="lh">גודל 3x3</span></div><div class="sr"><span class="l">Uses 5 MW</span><span class="lh">צורך 5 מגה-וואט</span></div><div class="sr"><span class="l">Jobs 10</span><span class="lh">משרות 10</span></div></div>
</div></div>
<h2 id="cat-ground">Ground and zones <span class="hh">קרקע ואזורים</span></h2>
<div class="grid"><div class="card" id="zR">
