  <div class="nm">Clear Zone</div><div class="nmh">ניקוי אזור</div>
  <div class="stats"></div><div class="hint">Drag to clear empty zones.</div>
</div>
<div class="card" id="regolith">
  <div class="imgbox"><img src="data:image/png;base64," alt="Regolith Cover" loading="lazy"></div>
